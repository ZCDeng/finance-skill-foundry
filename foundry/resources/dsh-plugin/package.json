{
  "name": "finance-skill-foundry-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "test": "node ./test.mjs && node ./completion-runtime.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "foundry": {
      "tools": [
        "create",
        "import",
        "lock",
        "record-questions",
        "record-reference",
        "emit-brief",
        "workpaper",
        "launch-formulator",
        "stop-formulator",
        "query-locked",
        "re-import"
      ],
      "harness": {
        "package": "@deepseek-ai/dsh",
        "version": "0.1.1-rc.2",
        "entry": "node_modules/@deepseek-ai/dsh/lib/bin.js"
      },
      "profiles": {
        "period": {
          "sandbox": "read-only",
          "cwd_writable": false,
          "omit": [
            "bash",
            "dsh-tool-fs",
            "str-replace-editor",
            "read_document"
          ],
          "tools": [
            "create",
            "import",
            "lock",
            "record-questions",
            "record-reference",
            "emit-brief",
            "workpaper",
            "launch-formulator",
            "stop-formulator",
            "query-locked",
            "re-import"
          ],
          "scope": "finance-skill-foundry-dsh/period-scope"
        },
        "f3": {
          "sandbox": "read-only",
          "tools": [
            "query-locked"
          ],
          "deny_paths": [
            "catalog.duckdb",
            "formulator",
            ".dsh-uploads"
          ],
          "omit": [
            "bash",
            "dsh-tool-fs",
            "str-replace-editor",
            "read_document"
          ],
          "scope": "finance-skill-foundry-dsh/f3-scope"
        },
        "analysis": {
          "sandbox": "bound-dataset-sql",
          "cwd_writable": false,
          "tools": [
            "analysis-state",
            "analysis-refresh",
            "dataset-add",
            "dataset-read",
            "method-resource",
            "analysis-save",
            "analysis-run",
            "analysis-script",
            "analysis-script-start",
            "analysis-delegate",
            "analysis-jobs",
            "analysis-job-output",
            "analysis-job-cancel",
            "analysis-job-retry",
            "analysis-draft",
            "analysis-export",
            "analysis-method-save",
            "analysis-method-apply",
            "list_finance_context",
            "finance_readiness",
            "chart_deliverable_save",
            "finance_context_save",
            "finance_map_save",
            "run_metric",
            "explain_variance",
            "drilldown_fact",
            "open_source_locator",
            "prepare_explanation",
            "validate_explanation",
            "save_explanation_draft",
            "finance_background_save",
            "finance_background_list",
            "finance_adjustment_list",
            "finance_controls_propose",
            "finance_controls_save",
            "finance_controls_run",
            "finance_controls_list",
            "finance_control_finding_save",
            "structure_proposal_list",
            "structure_proposal_confirm",
            "structure_template_list",
            "report_template_list",
            "report_template_apply",
            "finance_scenario_save",
            "finance_scenario_run",
            "finance_source_list",
            "finance_source_refresh",
            "workbook_inspect",
            "workbook_bind",
            "workbook_read",
            "workbook_range_preview",
            "workbook_preview",
            "workbook_apply",
            "analysis_requirements_save",
            "analysis_requirements_list"
          ],
          "harnessTools": [
            "skill",
            "todo_write",
            "ask_user_question",
            "create_goal",
            "update_goal",
            "get_goal",
            "exit_plan_mode",
            "web_search"
          ],
          "scope": "finance-skill-foundry-dsh/analysis",
          "execution": {
            "sql": "bound snapshots, explicit expressions, recorded runs",
            "shell": "isolated Python/shell runner with bound snapshot copies; unavailable platforms fail closed",
            "office": "draft exports via foundry; raw companion tools unavailable"
          },
          "childTools": [
            "analysis-state",
            "dataset-read",
            "method-resource",
            "analysis-save",
            "analysis-run",
            "analysis-script",
            "web_search",
            "skill",
            "todo_write",
            "create_goal",
            "update_goal",
            "get_goal",
            "exit_plan_mode",
            "list_finance_context",
            "finance_readiness",
            "finance_context_save",
            "run_metric",
            "explain_variance",
            "drilldown_fact",
            "open_source_locator",
            "prepare_explanation",
            "validate_explanation",
            "finance_scenario_save",
            "finance_scenario_run",
            "finance_source_list",
            "workbook_inspect",
            "workbook_read",
            "workbook_range_preview",
            "analysis_requirements_save",
            "analysis_requirements_list",
            "finance_adjustment_list",
            "finance_controls_propose",
            "finance_controls_run",
            "finance_controls_list",
            "structure_proposal_list",
            "structure_template_list",
            "report_template_list",
            "report_template_apply"
          ]
        }
      },
      "presets": {
        "dir": "./presets",
        "ids": [
          "analysis",
          "period",
          "f3"
        ],
        "fence": "./period.fence.yml"
      },
      "methodSkills": {
        "dir": "../method",
        "ids": [
          "financial-statements",
          "reconciliation",
          "variance-analysis",
          "journal-entry"
        ]
      },
      "companions": {
        "file-upload": {
          "id": "file-upload",
          "package": "dsh-file-upload",
          "version": "0.4.3",
          "add": "dsh plugin --profile web add dsh-file-upload@0.4.3",
          "source": "https://github.com/HongMing-Huang/dsh-file-upload",
          "role": "input-drop",
          "omitTools": [
            "read_document"
          ],
          "config": {
            "allowedExtensions": [
              "xlsx",
              "csv",
              "json"
            ],
            "inlineTextLimit": 0,
            "previewTextLimit": 0,
            "sheetRowLimit": 1,
            "maxSheets": 1,
            "readLimit": 1
          }
        },
        "office": {
          "id": "office",
          "package": "dsh-univer-office",
          "version": "0.2.12",
          "add": "staged into extra/dsh by scripts/fetch-harness.mjs; not added by hand",
          "source": "https://github.com/dream-num/dsh-univer-office",
          "role": "deliverable-surface",
          "env": {
            "DO_NOT_TRACK": "1",
            "UNIVER_TELEMETRY_ENDPOINT": ""
          },
          "omitTools": [
            "univer_new",
            "univer_status",
            "univer_worktree",
            "univer_unit",
            "univer_import",
            "univer_inspect",
            "univer_execute",
            "univer_export",
            "univer_lint",
            "univer_compile_svg",
            "univer_screenshot",
            "univer_api",
            "univer_resources"
          ],
          "egress": [
            "cdn.jsdelivr.net",
            "cdn.undraw.co"
          ],
          "licenseExpires": "2026-11-15"
        }
      }
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./f3-scope": "./f3-scope.js",
    "./period-scope": "./period-scope.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./analysis": "./analysis.js"
  }
}
