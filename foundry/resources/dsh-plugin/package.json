{
  "name": "finance-skill-foundry-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "test": "node ./test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "foundry": {
      "tools": [
        "create",
        "import",
        "lock",
        "record-questions",
        "record-reference",
        "emit-brief",
        "workpaper",
        "launch-formulator",
        "stop-formulator",
        "query-locked",
        "re-import"
      ],
      "harness": {
        "package": "@deepseek-ai/dsh",
        "version": "0.1.1-rc.2",
        "entry": "node_modules/@deepseek-ai/dsh/lib/bin.js"
      },
      "profiles": {
        "period": {
          "sandbox": "read-only",
          "cwd_writable": false,
          "omit": [
            "bash",
            "dsh-tool-fs",
            "str-replace-editor",
            "read_document"
          ],
          "tools": [
            "create",
            "import",
            "lock",
            "record-questions",
            "record-reference",
            "emit-brief",
            "workpaper",
            "launch-formulator",
            "stop-formulator",
            "query-locked",
            "re-import"
          ],
          "scope": "finance-skill-foundry-dsh/period-scope"
        },
        "f3": {
          "sandbox": "read-only",
          "tools": [
            "query-locked"
          ],
          "deny_paths": [
            "catalog.duckdb",
            "formulator",
            ".dsh-uploads"
          ],
          "omit": [
            "bash",
            "dsh-tool-fs",
            "str-replace-editor",
            "read_document"
          ],
          "scope": "finance-skill-foundry-dsh/f3-scope"
        }
      },
      "presets": {
        "dir": "./presets",
        "ids": [
          "period",
          "f3"
        ],
        "fence": "./period.fence.yml"
      },
      "methodSkills": {
        "dir": "../method",
        "ids": [
          "financial-statements",
          "reconciliation",
          "variance-analysis",
          "journal-entry"
        ]
      },
      "companions": {
        "file-upload": {
          "id": "file-upload",
          "package": "dsh-file-upload",
          "version": "0.4.3",
          "add": "dsh plugin --profile web add dsh-file-upload@0.4.3",
          "source": "https://github.com/HongMing-Huang/dsh-file-upload",
          "role": "input-drop",
          "omitTools": [
            "read_document"
          ],
          "config": {
            "allowedExtensions": [
              "xlsx",
              "csv",
              "json"
            ],
            "inlineTextLimit": 0,
            "previewTextLimit": 0,
            "sheetRowLimit": 1,
            "maxSheets": 1,
            "readLimit": 1
          }
        },
        "office": {
          "id": "office",
          "package": "dsh-univer-office",
          "version": "0.2.12",
          "add": "staged into extra/dsh by scripts/fetch-harness.mjs; not added by hand",
          "source": "https://github.com/dream-num/dsh-univer-office",
          "role": "deliverable-surface",
          "env": {
            "DO_NOT_TRACK": "1",
            "UNIVER_TELEMETRY_ENDPOINT": ""
          },
          "omitTools": [
            "univer_new",
            "univer_status",
            "univer_worktree",
            "univer_unit",
            "univer_import",
            "univer_inspect",
            "univer_execute",
            "univer_export",
            "univer_lint",
            "univer_compile_svg",
            "univer_screenshot",
            "univer_api",
            "univer_resources"
          ],
          "egress": [
            "cdn.jsdelivr.net",
            "cdn.undraw.co"
          ],
          "licenseExpires": "2026-11-15"
        }
      }
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./f3-scope": "./f3-scope.js",
    "./period-scope": "./period-scope.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}
