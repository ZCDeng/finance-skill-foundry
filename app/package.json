{
  "name": "finance-skill-foundry-app",
  "productName": "FA Foundry",
  "version": "0.1.9",
  "private": true,
  "description": "Desktop surface for the finance skill foundry: tasks, their inputs, and every version of what they produced",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron .",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "node scripts/fetch-harness.mjs",
    "harness:check": "node scripts/fetch-harness.mjs --check",
    "clean:electron": "rm -rf dist-electron dist-vite",
    "package": "npm run harness:check && npm run foundry:check && npm run formulator:check && npm run formulator:gate && npm run clean:electron && npm run build && electron-builder --mac --dir",
    "dist": "npm run harness:check && npm run foundry:check && npm run formulator:check && npm run formulator:gate && npm run clean:electron && npm run build && electron-builder --mac",
    "foundry": "node scripts/build-foundry.mjs",
    "foundry:check": "node scripts/build-foundry.mjs --check",
    "formulator": "node scripts/build-formulator.mjs",
    "formulator:check": "node scripts/build-formulator.mjs --check",
    "formulator:gate": "node scripts/gate-formulator.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/react": "^16.3.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "9.1.2",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "jsdom": "27.0.0",
    "lucide-react": "0.469.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "radix-ui": "^1.6.7"
  }
}
